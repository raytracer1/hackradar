generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Hackathon {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  url         String
  imageUrl    String?
  mode        String   @default("online")
  location    String?
  startDate   DateTime
  endDate     DateTime
  timezone    String?
  prizePool   String?
  themes      String   @default("[]")

  platformId String
  platform   Platform @relation(fields: [platformId], references: [id])

  sourceId   String  @unique
  source     String
  clusterKey String?

  status    String   @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Platform {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  websiteUrl String?
  logoUrl    String?
  hackathons Hackathon[]

  createdAt DateTime @default(now())
}
